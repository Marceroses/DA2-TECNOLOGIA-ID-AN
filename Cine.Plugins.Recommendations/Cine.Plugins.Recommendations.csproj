<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cine.Plugins.Abstractions\Cine.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <Target Name="CopyToPluginsFolder" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\CineWebApi\Plugins\" />
  </Target>

</Project>
